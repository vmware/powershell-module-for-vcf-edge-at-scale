            @{Path = "foundationLoadBalancerComponents.flbVirtualServerNetwork.flbNetworkName"; SiteSpec = $siteSpec},
            @{Path = "tkgsPrimaryWorkloadNetwork.tkgsPrimaryWorkloadNetworkName"; SiteSpec = $siteSpec},
